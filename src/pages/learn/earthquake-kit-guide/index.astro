---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { AFFILIATE_PRODUCTS } from '@/lib/affiliate-products';
import { generateBreadcrumbSchema } from '@/lib/seo';

const baseUrl = import.meta.env.PUBLIC_BASE_URL ?? 'https://baytremor.com';

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: baseUrl },
  { name: 'Learn', url: `${baseUrl}/learn` },
  { name: 'Earthquake Kit Guide', url: `${baseUrl}/learn/earthquake-kit-guide` },
]);

function getTopPick(category: string) {
  return AFFILIATE_PRODUCTS.find(p => p.category === category && p.badge === 'best-seller') ||
    AFFILIATE_PRODUCTS.find(p => p.category === category && p.badge === 'editor-pick') ||
    AFFILIATE_PRODUCTS.find(p => p.category === category);
}

const topPicks = [
  { category: 'emergency-kit', label: 'Best Emergency Kit', desc: 'Complete 3-day supply for 2 people' },
  { category: 'water-storage', label: 'Best Water Storage', desc: 'Portable, durable, BPA-free' },
  { category: 'furniture-safety', label: 'Best Furniture Straps', desc: 'Prevent furniture from falling' },
  { category: 'communication', label: 'Best Emergency Radio', desc: 'Hand-crank + solar-powered' },
  { category: 'first-aid', label: 'Best First Aid Kit', desc: 'Comprehensive 200-piece kit' },
].map(({ category, label, desc }) => ({ product: getTopPick(category), label, desc })).filter(({ product }) => !!product);

const productsByCategory = [
  { key: 'emergency-kit', title: 'Emergency Kits', icon: '🎒' },
  { key: 'water-storage', title: 'Water Storage', icon: '💧' },
  { key: 'furniture-safety', title: 'Furniture Safety', icon: '🔩' },
  { key: 'communication', title: 'Power & Communication', icon: '📡' },
  { key: 'first-aid', title: 'First Aid', icon: '🩹' },
  { key: 'food-storage', title: 'Food Storage', icon: '🥫' },
].map(({ key, title, icon }) => ({
  title, icon,
  products: AFFILIATE_PRODUCTS.filter(p => p.category === key),
})).filter(c => c.products.length > 0);

const badgeLabels: Record<string, string> = {
  'best-seller': "Best Seller",
  'editor-pick': "Editor's Pick",
  'best-value': "Best Value",
  'most-popular': "Most Popular",
};
---

<BaseLayout
  title="Best Earthquake Preparedness Products 2025 | Bay Tremor Buyer's Guide"
  description="Expert-reviewed earthquake preparedness products for Bay Area residents. Top-rated emergency kits, water storage, furniture straps, and more. Updated 2025."
  keywords="earthquake kit, earthquake preparedness products, best earthquake kit, emergency preparedness kit bay area"
  canonical={`${baseUrl}/learn/earthquake-kit-guide`}
  schema={breadcrumbSchema}
>
  <div class="min-h-screen bg-[#0a0a0a] text-white pb-20 md:pb-0">
    <div class="max-w-5xl mx-auto px-4 py-8">
      <nav class="mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-neutral-400 flex-wrap">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li>/</li>
          <li><a href="/learn" class="hover:text-white transition-colors">Learn</a></li>
          <li>/</li>
          <li class="text-white">Earthquake Kit Guide</li>
        </ol>
      </nav>

      <a href="/learn" class="inline-flex items-center gap-2 text-neutral-400 hover:text-white transition-colors mb-8 group">
        <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        Back to Learn
      </a>

      <!-- Header -->
      <header class="mb-10">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-sm px-3 py-1 bg-amber-500/20 text-amber-400 rounded-full border border-amber-500/30">Updated 2025</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Earthquake Preparedness Products</h1>
        <p class="text-xl text-neutral-400 max-w-3xl">
          Expert-reviewed picks for Bay Area residents. Every product is selected based on ratings, reviews, and real earthquake preparedness needs.
        </p>
        <p class="text-sm text-neutral-500 mt-4">
          Disclosure: Bay Tremor may earn a commission from qualifying Amazon purchases at no extra cost to you. We only recommend products we believe are genuinely useful.
        </p>
      </header>

      <!-- Top Picks Grid -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
          <svg class="w-6 h-6 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Our Top Picks
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
          {topPicks.map(({ product, label, desc }) => product && (
            <a href={product.affiliateUrl} target="_blank" rel="noopener noreferrer sponsored"
              class="group bg-neutral-900 rounded-xl border border-white/10 hover:border-amber-500/30 transition-all overflow-hidden">
              <div class="px-4 py-3 bg-amber-500/10 border-b border-white/5">
                <div class="text-xs text-amber-400 font-semibold uppercase tracking-wide">{label}</div>
              </div>
              <div class="p-4 flex gap-4 items-center">
                <img src={product.imageUrl} alt={product.shortName} class="w-16 h-16 object-contain rounded-lg bg-white p-1 flex-shrink-0" loading="lazy" />
                <div class="flex-1 min-w-0">
                  <div class="font-semibold text-sm truncate">{product.shortName}</div>
                  <div class="text-xs text-neutral-400 mt-0.5">{desc}</div>
                  <div class="flex items-center gap-2 mt-2">
                    <span class="text-amber-400 font-bold">${product.price}</span>
                    {product.originalPrice && <span class="text-neutral-600 line-through text-sm">${product.originalPrice}</span>}
                  </div>
                </div>
                <svg class="w-4 h-4 text-neutral-500 group-hover:text-amber-400 transition-colors flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Products by Category -->
      {productsByCategory.map(({ title, icon, products }) => (
        <section class="mb-12">
          <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
            <span class="text-2xl">{icon}</span>
            {title}
          </h2>
          <div class="space-y-4">
            {products.map(product => (
              <div class="bg-neutral-900 rounded-xl border border-white/10 overflow-hidden">
                {product.badge && (
                  <div class="px-4 py-2 bg-gradient-to-r from-amber-500/10 to-orange-500/10 border-b border-white/5">
                    <span class="text-xs text-amber-400 font-bold uppercase tracking-wide">{badgeLabels[product.badge] ?? product.badge}</span>
                  </div>
                )}
                <div class="p-5">
                  <div class="flex gap-5 flex-col sm:flex-row">
                    <a href={product.affiliateUrl} target="_blank" rel="noopener noreferrer sponsored" class="sm:w-32 flex-shrink-0">
                      <div class="aspect-square bg-white rounded-xl overflow-hidden">
                        <img src={product.imageUrl} alt={product.name} class="w-full h-full object-contain p-3" loading="lazy" />
                      </div>
                    </a>
                    <div class="flex-1">
                      <h3 class="text-lg font-bold mb-1">{product.name}</h3>

                      <!-- Rating -->
                      <div class="flex items-center gap-2 mb-3">
                        <div class="flex items-center gap-0.5">
                          {Array.from({ length: 5 }, (_, i) => (
                            <svg class={`w-4 h-4 ${i < Math.floor(product.rating) ? 'text-amber-400 fill-amber-400' : 'text-neutral-600'}`} viewBox="0 0 24 24" stroke="currentColor" stroke-width="1"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                          ))}
                        </div>
                        <span class="text-sm text-amber-400 font-medium">{product.rating}</span>
                        <span class="text-sm text-neutral-500">({product.reviewCount.toLocaleString()} reviews)</span>
                      </div>

                      <p class="text-neutral-300 mb-3 text-sm leading-relaxed">{product.description}</p>

                      <div class="mb-4 p-3 bg-white/5 rounded-lg">
                        <span class="text-xs font-semibold text-neutral-400">Why we recommend: </span>
                        <span class="text-xs text-neutral-300">{product.whyRecommended}</span>
                      </div>

                      <div class="flex items-center gap-4 flex-wrap">
                        <div class="flex items-center gap-2">
                          <span class="text-2xl font-bold text-white">${product.price}</span>
                          {product.originalPrice && <span class="text-neutral-500 line-through">${product.originalPrice}</span>}
                        </div>
                        {product.primeEligible && (
                          <span class="text-xs text-[#FF9900] font-semibold">✓ Prime</span>
                        )}
                        <a href={product.affiliateUrl} target="_blank" rel="noopener noreferrer sponsored"
                          class="ml-auto px-4 py-2 bg-amber-500 hover:bg-amber-400 text-black font-semibold rounded-lg transition-colors text-sm">
                          View on Amazon →
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}

      <!-- Checklist CTA -->
      <div class="bg-gradient-to-r from-emerald-500/10 to-blue-500/10 border border-emerald-500/20 rounded-2xl p-8 text-center">
        <h2 class="text-2xl font-bold mb-3">Not Sure Where to Start?</h2>
        <p class="text-neutral-400 mb-6 max-w-xl mx-auto">Our complete earthquake preparedness guide has a step-by-step checklist to help you build your emergency kit and safety plan.</p>
        <a href="/earthquake-preparedness" class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-500 text-white rounded-xl font-semibold hover:bg-emerald-600 transition-colors">
          View Full Preparedness Guide
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
