---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { HistoryFeed } from '@/components/history-feed';
import { loadHistoricalEarthquakes, getHistoricalSummary } from '@/lib/historical';
import { loadAllEarthquakes } from '@/lib/server-data';
import { getRegionById } from '@/lib/regions';
import { getEarthquakesSince, HISTORICAL_CUTOFF_MS } from '@/lib/earthquakes-db';
import type { Earthquake } from '@/lib/types';

const { env } = Astro.locals.runtime;

// Pull historical data + summary + post-cutoff D1 data in parallel. Fall back
// to the USGS week feed if HISTORICAL_R2 is empty (not yet uploaded).
const [r2Quakes, summary, weekQuakes, recentQuakes] = await Promise.all([
  loadHistoricalEarthquakes(env.HISTORICAL_R2),
  getHistoricalSummary(env.HISTORICAL_R2, env.EARTHQUAKE_KV, env.DB),
  loadAllEarthquakes('all_week'),
  env.DB
    ? getEarthquakesSince(env.DB, HISTORICAL_CUTOFF_MS)
    : Promise.resolve([] as Earthquake[]),
]);

// Merge R2 (historical) + D1 (post-cutoff), dedupe by id, newest first.
const seen = new Set<string>();
const merged: Earthquake[] = [];
for (const q of recentQuakes) {
  if (!seen.has(q.id)) { seen.add(q.id); merged.push(q); }
}
for (const q of r2Quakes) {
  if (!seen.has(q.id)) { seen.add(q.id); merged.push(q); }
}
merged.sort((a, b) => b.timestamp - a.timestamp);

const historicalQuakes = merged;
const allQuakes = historicalQuakes.length > 0 ? historicalQuakes : weekQuakes;
const hasHistorical = historicalQuakes.length > 0;

const top25 = allQuakes.slice(0, 25).map(eq => ({
  id: eq.id,
  magnitude: eq.magnitude,
  place: eq.place,
  timestamp: eq.timestamp,
  latitude: eq.latitude,
  longitude: eq.longitude,
  depth: eq.depth,
  felt: eq.felt,
  significance: eq.significance,
  url: eq.url,
  region: eq.region,
}));

const dataStartYear = hasHistorical
  ? new Date(summary.dateRange.start).getFullYear()
  : new Date().getFullYear();
const yearsCovered = hasHistorical
  ? Math.max(1, new Date().getFullYear() - dataStartYear + 1)
  : 0;

const maxRegionCount = summary.regionStats.length > 0
  ? Math.max(...summary.regionStats.map(r => r.totalCount), 1)
  : 1;

const topRegions = summary.regionStats
  .filter(r => r.totalCount > 0)
  .sort((a, b) => b.totalCount - a.totalCount)
  .slice(0, 4);
---

<BaseLayout
  title="Historical Earthquake Analysis | Bay Tremor - Bay Area Earthquake Tracker"
  description="Explore historical earthquake data for the Bay Area. Analyze past seismic events, swarm patterns, and trends along the Calaveras, Hayward, and San Andreas fault lines."
  canonical="https://baytremor.com/history"
>
  <div class="min-h-screen bg-[#0a0a0a] text-white pb-24 md:pb-6">
    <div class="max-w-7xl mx-auto px-3 sm:px-4 md:px-6">
      <header class="pt-6 sm:pt-8 pb-6">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">Earthquake History</h1>
        <p class="text-neutral-400 mt-2 text-sm sm:text-base max-w-2xl">
          {hasHistorical ? `${yearsCovered} years of` : 'Recent'} Bay Area seismic data — swarm patterns,
          magnitude trends, and regional comparisons along the Calaveras, Hayward, and San Andreas fault lines.
        </p>
      </header>
    </div>

    <div class="max-w-7xl mx-auto px-3 sm:px-4 md:px-6 space-y-6">
      {hasHistorical && (
        <section class="grid md:grid-cols-2 gap-6">
          <div class="card p-6">
            <h3 class="font-semibold mb-4">{yearsCovered} Years of Data</h3>
            <div class="space-y-4">
              <div class="flex items-center justify-between py-3 border-b border-white/5">
                <span class="text-neutral-400">Total Earthquakes</span>
                <span class="text-2xl font-light">{summary.totalCount.toLocaleString()}</span>
              </div>
              <div class="flex items-center justify-between py-3 border-b border-white/5">
                <span class="text-neutral-400">Swarm Events Detected</span>
                <span class="text-2xl font-light">{summary.swarmSummaries.length}</span>
              </div>
              <div class="flex items-center justify-between py-3 border-b border-white/5">
                <span class="text-neutral-400">Largest Recorded</span>
                <span class="text-2xl font-light">M{summary.biggestQuake?.magnitude.toFixed(1) ?? '—'}</span>
              </div>
              <div class="flex items-center justify-between py-3">
                <span class="text-neutral-400">Data Range</span>
                <span class="text-sm text-neutral-300">{dataStartYear} – Present</span>
              </div>
            </div>
          </div>

          <div class="card p-6">
            <h3 class="font-semibold mb-4">Regional Comparison</h3>
            <p class="text-sm text-neutral-400 mb-4">
              How does earthquake activity compare across Northern California regions?
            </p>
            <div class="space-y-4">
              {topRegions.map(stat => {
                const region = getRegionById(stat.regionId);
                const widthPct = Math.round((stat.totalCount / maxRegionCount) * 100);
                return (
                  <div class="space-y-2">
                    <div class="flex items-center justify-between text-sm">
                      <span class="text-neutral-300">{region?.name || stat.regionId}</span>
                      <span class="text-neutral-500">{stat.totalCount.toLocaleString()}</span>
                    </div>
                    <div class="h-2 bg-white/5 rounded-full overflow-hidden">
                      <div
                        class="h-full rounded-full"
                        style={`width: ${widthPct}%; background-color: ${region?.color || '#6b7280'};`}
                      />
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </section>
      )}

      <HistoryFeed client:load initialData={top25} totalCount={allQuakes.length} />
    </div>
  </div>
</BaseLayout>
