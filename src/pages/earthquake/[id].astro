---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getMagnitudeColor, getMagnitudeLabel } from '@/lib/analysis';
import { getRegionForCoordinates, getRegionById, getLocationContext, kmToMiles } from '@/lib/regions';
import { generateEarthquakeEventSchema, generateEarthquakeArticleSchema, generateBreadcrumbSchema } from '@/lib/seo';

const baseUrl = import.meta.env.PUBLIC_BASE_URL ?? 'https://baytremor.com';
const { id } = Astro.params;

interface EarthquakeDetail {
  id: string;
  magnitude: number;
  place: string;
  time: Date;
  timestamp: number;
  latitude: number;
  longitude: number;
  depth: number;
  felt: number | null;
  significance: number;
  url?: string;
  region: string;
}

async function getEarthquake(eqId: string): Promise<EarthquakeDetail | null> {
  try {
    const response = await fetch(
      `https://earthquake.usgs.gov/earthquakes/feed/v1.0/detail/${eqId}.geojson`,
      { signal: AbortSignal.timeout(5000) }
    );
    if (response.ok) {
      const feature = await response.json() as {
        id: string;
        geometry: { coordinates: [number, number, number] };
        properties: { mag: number; place: string; time: number; felt: number | null; sig: number; url?: string };
      };
      const [longitude, latitude, depth] = feature.geometry.coordinates;
      return {
        id: feature.id,
        magnitude: feature.properties.mag,
        place: feature.properties.place,
        time: new Date(feature.properties.time),
        timestamp: feature.properties.time,
        latitude,
        longitude,
        depth,
        felt: feature.properties.felt,
        significance: feature.properties.sig,
        url: feature.properties.url,
        region: getRegionForCoordinates(latitude, longitude),
      };
    }
  } catch {
    // Return null on error
  }
  return null;
}

const earthquake = await getEarthquake(id!);

if (!earthquake) {
  return Astro.redirect('/today', 307);
}

const region = getRegionById(earthquake.region);
const locationContext = getLocationContext(earthquake.latitude, earthquake.longitude);
const magnitudeColor = getMagnitudeColor(earthquake.magnitude);
const magnitudeLabel = getMagnitudeLabel(earthquake.magnitude);

const formattedDate = earthquake.time.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const title = `M${earthquake.magnitude.toFixed(1)} Earthquake ${earthquake.place} - ${formattedDate}`;
const description = `A ${magnitudeLabel.toLowerCase()} magnitude ${earthquake.magnitude.toFixed(1)} earthquake occurred ${earthquake.place} on ${formattedDate} at a depth of ${earthquake.depth.toFixed(1)}km.${earthquake.felt ? ` Felt by ${earthquake.felt} people.` : ''} View detailed seismic data.`;

const eventSchema = generateEarthquakeEventSchema({
  id: earthquake.id,
  magnitude: earthquake.magnitude,
  place: earthquake.place,
  timestamp: earthquake.timestamp,
  latitude: earthquake.latitude,
  longitude: earthquake.longitude,
  depth: earthquake.depth,
  felt: earthquake.felt,
});

const articleSchema = generateEarthquakeArticleSchema({
  id: earthquake.id,
  magnitude: earthquake.magnitude,
  place: earthquake.place,
  timestamp: earthquake.timestamp,
  depth: earthquake.depth,
  region: earthquake.region,
  felt: earthquake.felt,
  latitude: earthquake.latitude,
  longitude: earthquake.longitude,
});

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', url: baseUrl },
  { name: region?.name || 'Region', url: region ? `${baseUrl}/region/${region.id}` : baseUrl },
  { name: `M${earthquake.magnitude.toFixed(1)} ${earthquake.place.split(',')[0]}`, url: `${baseUrl}/earthquake/${earthquake.id}` },
]);

const depthCategory = earthquake.depth < 10 ? 'Very Shallow' : earthquake.depth < 30 ? 'Shallow' : earthquake.depth < 70 ? 'Intermediate' : 'Deep';
const usgsUrl = earthquake.url || `https://earthquake.usgs.gov/earthquakes/eventpage/${earthquake.id}`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${baseUrl}/earthquake/${earthquake.id}`}
  schema={[eventSchema, articleSchema, breadcrumbSchema]}
>
  <div class="min-h-screen bg-[#0a0a0a] text-white pb-20 md:pb-0">
    <!-- Sticky Header -->
    <header class="sticky top-0 z-50 bg-[#0a0a0a]/90 backdrop-blur-xl border-b border-white/10">
      <div class="max-w-4xl mx-auto px-4 py-4">
        <div class="flex items-center justify-between">
          <a href="/" class="flex items-center gap-3 text-neutral-400 hover:text-white transition-colors group">
            <svg class="w-5 h-5 transition-transform group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            <span class="font-medium">Bay Area Quake Tracker</span>
          </a>
          <div class="flex items-center gap-2 px-3 py-1.5 bg-white/10 rounded-full border border-white/20">
            <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
            <span class="text-white text-sm font-medium">Live</span>
          </div>
        </div>
      </div>
    </header>

    <main class="px-4 py-8 max-w-4xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-neutral-400 flex-wrap">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li>/</li>
          {region && (
            <>
              <li><a href={`/region/${region.id}`} class="hover:text-white transition-colors">{region.name.split(' / ')[0]}</a></li>
              <li>/</li>
            </>
          )}
          <li class="text-white truncate max-w-[200px]">M{earthquake.magnitude.toFixed(1)} {earthquake.place.split(',')[0]}</li>
        </ol>
      </nav>

      <!-- Magnitude Hero -->
      <div class="rounded-2xl p-8 mb-8 text-center border" style={`background-color: ${magnitudeColor}10; border-color: ${magnitudeColor}30`}>
        <div class="text-8xl font-bold mb-2" style={`color: ${magnitudeColor}`}>
          M{earthquake.magnitude.toFixed(1)}
        </div>
        <div class="text-2xl font-semibold text-white mb-2">{magnitudeLabel}</div>
        <div class="text-neutral-400">{earthquake.place}</div>
        <div class="text-sm text-neutral-500 mt-2">
          {earthquake.time.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}
          {' '}at{' '}
          {earthquake.time.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', timeZoneName: 'short' })}
        </div>
      </div>

      <!-- Key Details Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-neutral-900 rounded-xl p-5 border border-white/10">
          <div class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Depth</div>
          <div class="text-2xl font-bold">{earthquake.depth.toFixed(1)}km</div>
          <div class="text-xs text-neutral-500">{depthCategory}</div>
        </div>
        <div class="bg-neutral-900 rounded-xl p-5 border border-white/10">
          <div class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Felt Reports</div>
          <div class="text-2xl font-bold">{earthquake.felt ?? 0}</div>
          <div class="text-xs text-neutral-500">people</div>
        </div>
        <div class="bg-neutral-900 rounded-xl p-5 border border-white/10">
          <div class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Significance</div>
          <div class="text-2xl font-bold">{earthquake.significance}</div>
          <div class="text-xs text-neutral-500">USGS score</div>
        </div>
        <div class="bg-neutral-900 rounded-xl p-5 border border-white/10">
          <div class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Region</div>
          <div class="text-lg font-bold leading-tight">{region?.name?.split(' / ')[0] || 'Bay Area'}</div>
          <div class="text-xs text-neutral-500">{region?.county || ''} County</div>
        </div>
      </div>

      <!-- Location Info -->
      <div class="bg-neutral-900 rounded-xl p-6 border border-white/10 mb-8">
        <h2 class="text-xl font-bold mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          Location Details
        </h2>
        <div class="grid grid-cols-2 gap-4 text-sm">
          <div>
            <div class="text-neutral-500">Latitude</div>
            <div class="font-mono">{earthquake.latitude.toFixed(4)}°N</div>
          </div>
          <div>
            <div class="text-neutral-500">Longitude</div>
            <div class="font-mono">{earthquake.longitude.toFixed(4)}°W</div>
          </div>
          {locationContext && (
            <>
              <div>
                <div class="text-neutral-500">Nearest City</div>
                <div>{locationContext.nearestCity}</div>
              </div>
              <div>
                <div class="text-neutral-500">Distance</div>
                <div>{kmToMiles(locationContext.distanceKm).toFixed(1)} miles</div>
              </div>
            </>
          )}
        </div>
        {region && (
          <div class="mt-4 pt-4 border-t border-white/5">
            <div class="text-neutral-500 text-sm mb-1">Fault Line</div>
            <div class="font-medium">{region.faultLine}</div>
          </div>
        )}
      </div>

      <!-- What This Means -->
      <div class="bg-neutral-900 rounded-xl p-6 border border-white/10 mb-8">
        <h2 class="text-xl font-bold mb-4">What This Means</h2>
        <p class="text-neutral-300 mb-3">
          A magnitude {earthquake.magnitude.toFixed(1)} earthquake is classified as <strong class="text-white">{magnitudeLabel}</strong>.
          {earthquake.magnitude < 2.0 && ' Earthquakes below M2.0 are generally not felt and are detected only by instruments.'}
          {earthquake.magnitude >= 2.0 && earthquake.magnitude < 3.0 && ' These are minor earthquakes that may be felt slightly near the epicenter but rarely cause damage.'}
          {earthquake.magnitude >= 3.0 && earthquake.magnitude < 4.0 && ' These earthquakes are often felt near the epicenter but rarely cause significant damage.'}
          {earthquake.magnitude >= 4.0 && earthquake.magnitude < 5.0 && ' These moderate earthquakes are felt widely and can cause minor damage to poorly constructed buildings.'}
          {earthquake.magnitude >= 5.0 && ' Earthquakes at this magnitude can cause significant damage to poorly constructed buildings and are widely felt.'}
        </p>
        <p class="text-neutral-300">
          At {earthquake.depth.toFixed(1)}km depth, this is a {depthCategory.toLowerCase()} earthquake.
          {earthquake.depth < 20 && ' Shallow earthquakes tend to produce more intense shaking near the epicenter.'}
          {earthquake.depth >= 20 && earthquake.depth < 70 && ' At this intermediate depth, shaking is distributed over a wider area with moderate intensity.'}
        </p>
      </div>

      <!-- Risk report CTA — the moment someone feels a quake is peak intent -->
      <a
        href="/my-area?src=quake-page"
        class="flex flex-col sm:flex-row sm:items-center gap-4 p-5 mb-8 rounded-xl border border-amber-500/25 bg-amber-500/[0.06] hover:bg-amber-500/10 transition-colors group"
      >
        <div class="w-10 h-10 rounded-xl bg-amber-500/15 flex items-center justify-center flex-shrink-0">
          <svg class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <div class="flex-1">
          <div class="font-semibold text-white">What does this mean for your home?</div>
          <div class="text-sm text-neutral-400 mt-0.5">
            Free report for your exact address: nearest fault, state liquefaction &amp; landslide zones, and felt-quake history.
          </div>
        </div>
        <span class="text-sm font-medium text-amber-300 whitespace-nowrap group-hover:translate-x-0.5 transition-transform">
          Check my address →
        </span>
      </a>

      <!-- Did You Feel It + Links -->
      <div class="grid md:grid-cols-2 gap-4 mb-8">
        <a href={usgsUrl} target="_blank" rel="noopener noreferrer"
          class="flex items-center gap-4 p-5 bg-neutral-900 rounded-xl border border-white/10 hover:bg-white/5 transition-colors">
          <svg class="w-8 h-8 text-blue-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
          <div>
            <div class="font-semibold">View on USGS</div>
            <div class="text-sm text-neutral-400">Official data & felt reports</div>
          </div>
          <svg class="w-4 h-4 text-neutral-400 ml-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
        <a href="/today" class="flex items-center gap-4 p-5 bg-neutral-900 rounded-xl border border-white/10 hover:bg-white/5 transition-colors">
          <svg class="w-8 h-8 text-red-400 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="2"/><path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"/></svg>
          <div>
            <div class="font-semibold">All Earthquakes Today</div>
            <div class="text-sm text-neutral-400">See the full Bay Area activity</div>
          </div>
        </a>
      </div>

      {region && (
        <div class="bg-neutral-900 rounded-xl p-6 border border-white/10 mb-8">
          <h2 class="text-xl font-bold mb-2">About This Region</h2>
          <p class="text-neutral-300 mb-4">{region.description}</p>
          <a href={`/region/${region.id}`} class="text-blue-400 hover:text-blue-300 transition-colors text-sm">
            View all {region.name} earthquakes →
          </a>
        </div>
      )}
    </main>

    <footer class="max-w-4xl mx-auto px-4 py-8 mt-4 border-t border-white/5">
      <p class="text-sm text-neutral-500 text-center">
        Data from <a href="https://earthquake.usgs.gov/" class="text-neutral-400 hover:text-white transition-colors">USGS Earthquake Hazards Program</a>
      </p>
      <p class="text-xs text-neutral-600 mt-2 text-center">
        This site provides real-time earthquake information for educational purposes. For emergencies, dial 911.
      </p>
    </footer>
  </div>
</BaseLayout>
