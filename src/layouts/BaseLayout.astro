---
import '../styles/globals.css';
import { NavBarWithProviders } from '@/components/nav-bar-with-providers';
import { generateHomepageSchemas } from '@/lib/seo';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: object | object[];
}

const baseUrl = import.meta.env.PUBLIC_BASE_URL ?? 'https://baytremor.com';

const {
  title = 'Bay Area Earthquake Tracker | Live Seismic Activity Map & Alerts Today',
  description = '🔴 LIVE Bay Area earthquake tracker with real-time USGS data. Track earthquakes in San Francisco, Oakland, San Jose & 80+ cities. Updated every minute.',
  keywords,
  canonical = Astro.url.href,
  ogImage = `${baseUrl}/og-image.png`,
  noindex = false,
  schema,
} = Astro.props;

const schemas = schema ?? generateHomepageSchemas();
const appVersion = Astro.locals.runtime?.env?.CF_VERSION_METADATA?.id ?? 'dev';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="theme-color" content="#0a0a0a" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Bay Tremor" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@baytremor" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Geo -->
    <meta name="geo.region" content="US-CA" />
    <meta name="geo.placename" content="San Francisco Bay Area" />
    <meta name="geo.position" content="37.75;-122.25" />
    <meta name="ICBM" content="37.75, -122.25" />
    <meta name="impact-site-verification" content="f0b61dfc-b575-4c4c-ab15-c6c6df6d9cff" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Bay Tremor - Earthquake Feed"
      href={`${baseUrl}/feed.xml`}
    />

    <!-- DNS prefetch -->
    <link rel="dns-prefetch" href="https://m.media-amazon.com" />
    <link rel="preconnect" href="https://m.media-amazon.com" crossorigin="anonymous" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
    <slot name="head" />

    <meta name="app-version" content={appVersion} />

    <!-- First-party telemetry transport + stale-asset recovery. Inline so it
         still works when bundled chunks fail to load. -->
    <script is:inline define:vars={{ appVersion }}>
      (function () {
        var ENDPOINT = '/api/events';
        var queue = [];
        var timer = null;
        function makeId() {
          return window.crypto && crypto.randomUUID ? crypto.randomUUID() : String(Math.random()).slice(2) + Date.now();
        }
        function remember(kind, key, make) {
          try {
            var store = window[kind];
            var value = store.getItem(key);
            if (!value) { value = make(); store.setItem(key, value); }
            return value;
          } catch (e) { return make(); }
        }
        var vid = remember('localStorage', 'bt-vid', makeId);
        var sid = remember('sessionStorage', 'bt-sid', makeId);
        var landing = remember('sessionStorage', 'bt-landing', function () { return location.pathname; });
        var ref = remember('sessionStorage', 'bt-ref', function () { return document.referrer || ''; });
        var internal = false;
        try { internal = localStorage.getItem('bt-internal') === '1'; } catch (e) {}

        function flush() {
          if (timer) { clearTimeout(timer); timer = null; }
          while (queue.length) {
            var body = JSON.stringify({
              v: appVersion, sid: sid, vid: vid, path: location.pathname, landing: landing, ref: ref,
              wd: navigator.webdriver === true, internal: internal, events: queue.splice(0, 25),
            });
            var sent = false;
            try { sent = !!(navigator.sendBeacon && navigator.sendBeacon(ENDPOINT, new Blob([body], { type: 'text/plain' }))); } catch (e) {}
            if (!sent) {
              try { fetch(ENDPOINT, { method: 'POST', body: body, keepalive: true, headers: { 'Content-Type': 'text/plain' } }); } catch (e) {}
            }
          }
        }
        window.btTrack = function (name, props, value) {
          queue.push({ n: name, p: props || {}, val: typeof value === 'number' ? value : undefined });
          if (queue.length >= 20) flush();
          else if (!timer) timer = setTimeout(flush, 5000);
        };
        addEventListener('visibilitychange', function () { if (document.visibilityState === 'hidden') flush(); });
        addEventListener('pagehide', flush);

        var CHUNK_ERROR = /Failed to fetch dynamically imported module|error loading dynamically imported module|Importing a module script failed|Unable to preload CSS|ChunkLoadError|Loading chunk/i;
        function recover(message, source) {
          window.btTrack('asset_load_failed', { message: String(message).slice(0, 160), source: source });
          var key = 'bt-asset-reload:' + appVersion;
          var alreadyTried = true;
          try { alreadyTried = sessionStorage.getItem(key) === '1'; sessionStorage.setItem(key, '1'); } catch (e) {}
          if (alreadyTried) return;
          window.btTrack('asset_reload_attempted', { source: source });
          flush();
          location.reload();
        }
        addEventListener('vite:preloadError', function (event) {
          event.preventDefault();
          recover((event.payload && event.payload.message) || 'preload failed', 'vite');
        });
        addEventListener('error', function (event) {
          var target = event.target;
          if (target && target !== window && (target.tagName === 'SCRIPT' || target.tagName === 'LINK')) {
            var url = target.src || target.href || '';
            if (url.indexOf('/_astro/') !== -1) recover('resource failed: ' + url.replace(location.origin, ''), 'resource');
            return;
          }
          var message = event.message || '';
          if (!message || message === 'Script error.') return;
          if (CHUNK_ERROR.test(message)) return recover(message, 'error');
          window.btTrack('js_error', {
            message: message.slice(0, 160),
            source: (event.filename || '').replace(location.origin, '').slice(0, 120),
            line: event.lineno || 0,
            kind: 'error',
          });
        }, true);
        addEventListener('unhandledrejection', function (event) {
          var reason = event.reason;
          var message = (reason && reason.message) || String(reason);
          if (CHUNK_ERROR.test(message)) return recover(message, 'rejection');
          window.btTrack('js_error', { message: message.slice(0, 160), kind: 'unhandledrejection' });
        });
        window.btTrack('client_page_view', {});
      })();
    </script>

    <!-- Core Web Vitals -> /api/events -->
    <script>
      import { onCLS, onFCP, onINP, onLCP, onTTFB, type MetricWithAttribution } from 'web-vitals/attribution';

      function report(metric: MetricWithAttribution) {
        const attribution = metric.attribution as { target?: string; interactionTarget?: string; largestShiftTarget?: string } | undefined;
        window.btTrack?.('web_vital', {
          metric: metric.name,
          rating: metric.rating,
          navigationType: metric.navigationType,
          target: (attribution?.target ?? attribution?.interactionTarget ?? attribution?.largestShiftTarget ?? '').slice(0, 120),
        }, metric.value);
      }
      onLCP(report);
      onINP(report);
      onCLS(report);
      onFCP(report);
      onTTFB(report);
    </script>

    <!-- Google Analytics (Sprint 6: move to CF Analytics Engine) -->
    {import.meta.env.PUBLIC_GA_ID && (
      <script
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}
      />
      <script define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    )}

    <!-- AdSense -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2599154949047210"
      crossorigin="anonymous"
    />
  </head>
  <body class="font-sans antialiased min-h-screen">
    <NavBarWithProviders client:load currentPath={Astro.url.pathname} />
    <slot />
  </body>
</html>
