---
import '../styles/globals.css';
import { NavBarWithProviders } from '@/components/nav-bar-with-providers';
import { generateHomepageSchemas } from '@/lib/seo';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: object | object[];
}

const baseUrl = import.meta.env.PUBLIC_BASE_URL ?? 'https://baytremor.com';

const {
  title = 'Bay Area Earthquake Tracker | Live Seismic Activity Map & Alerts Today',
  description = '🔴 LIVE Bay Area earthquake tracker with real-time USGS data. Track earthquakes in San Francisco, Oakland, San Jose & 80+ cities. Updated every minute.',
  keywords,
  canonical = Astro.url.href,
  ogImage = `${baseUrl}/og-image.png`,
  noindex = false,
  schema,
} = Astro.props;

const schemas = schema ?? generateHomepageSchemas();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5" />
    <meta name="theme-color" content="#0a0a0a" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Bay Tremor" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@baytremor" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Geo -->
    <meta name="geo.region" content="US-CA" />
    <meta name="geo.placename" content="San Francisco Bay Area" />
    <meta name="geo.position" content="37.75;-122.25" />
    <meta name="ICBM" content="37.75, -122.25" />
    <meta name="impact-site-verification" content="f0b61dfc-b575-4c4c-ab15-c6c6df6d9cff" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Bay Tremor - Earthquake Feed"
      href={`${baseUrl}/feed.xml`}
    />

    <!-- DNS prefetch -->
    <link rel="dns-prefetch" href="https://m.media-amazon.com" />
    <link rel="preconnect" href="https://m.media-amazon.com" crossorigin="anonymous" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
    <slot name="head" />

    <!-- Datadog RUM (bundled + hoisted so it initializes before hydration) -->
    <script>
      import { datadogRum } from '@datadog/browser-rum';

      const applicationId = import.meta.env.PUBLIC_DD_APPLICATION_ID;
      const clientToken = import.meta.env.PUBLIC_DD_CLIENT_TOKEN;
      const site = import.meta.env.PUBLIC_DD_SITE || 'datadoghq.com';
      const env = import.meta.env.PUBLIC_DD_ENV || (import.meta.env.PROD ? 'prod' : 'dev');
      const version = import.meta.env.PUBLIC_DD_VERSION || '2.0.0';

      if (applicationId && clientToken && !datadogRum.getInitConfiguration()) {
        datadogRum.init({
          applicationId,
          clientToken,
          site,
          service: 'BayTremor',
          env,
          version,
          sessionSampleRate: 100,
          sessionReplaySampleRate: 100,
          trackUserInteractions: true,
          trackResources: true,
          trackLongTasks: true,
          defaultPrivacyLevel: 'mask-user-input',
          enableExperimentalFeatures: ['feature_flags'],
          allowedTracingUrls: [
            { match: /https:\/\/.*\.baytremor\.com/, propagatorTypes: ['tracecontext', 'datadog'] },
            { match: window.location.origin, propagatorTypes: ['tracecontext', 'datadog'] },
          ],
        });
        datadogRum.setGlobalContextProperty('app_name', 'baytremor.com');
        datadogRum.setGlobalContextProperty('region', 'bay_area');
        // Expose for helper functions elsewhere in the app.
        (window as any).__ddRum = datadogRum;
      } else if (!applicationId || !clientToken) {
        if (import.meta.env.DEV) {
          console.warn(
            '[Datadog RUM] Not initialized — set PUBLIC_DD_APPLICATION_ID and PUBLIC_DD_CLIENT_TOKEN in .env'
          );
        }
      }
    </script>

    <!-- Google Analytics (Sprint 6: move to CF Analytics Engine) -->
    {import.meta.env.PUBLIC_GA_ID && (
      <script
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}
      />
      <script define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    )}

    <!-- AdSense -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2599154949047210"
      crossorigin="anonymous"
    />
  </head>
  <body class="font-sans antialiased min-h-screen">
    <NavBarWithProviders client:load currentPath={Astro.url.pathname} />
    <slot />
  </body>
</html>
