<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Display Name -->
	<key>CFBundleDisplayName</key>
	<string>Bay Tremor</string>
	
	<!-- Bundle Name -->
	<key>CFBundleName</key>
	<string>Bay Tremor</string>
	
	<!-- Bundle Identifier -->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

	<!-- Executable (required for install) -->
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<!-- Package type -->
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	
	<!-- Version -->
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	
	<!-- Build Number -->
	<key>CFBundleVersion</key>
	<string>1</string>
	
	<!-- App Category -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.weather</string>
	
	<!-- Minimum iOS Version -->
	<key>MinimumOSVersion</key>
	<string>18.0</string>
	
	<!-- Privacy - Location Usage Descriptions -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Bay Tremor uses your location to show earthquakes near you and calculate distances from seismic events to your current position.</string>
	
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Bay Tremor uses your location to send you alerts about earthquakes near you, even when the app is in the background.</string>
	
	<!-- Privacy - Notification Usage -->
	<key>NSUserNotificationsUsageDescription</key>
	<string>Bay Tremor sends push notifications to alert you about significant earthquakes in your area.</string>
	
	<!-- App Transport Security -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>earthquake.usgs.gov</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>baytremor.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSExceptionRequiresForwardSecrecy</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	
	<!-- Background Modes -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	
	<!-- Supported Interface Orientations -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	
	<!-- Status Bar Style -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	
	<!-- Launch Screen (using UILaunchScreen for iOS 14+) -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>AccentColor</string>
		<key>UIImageName</key>
		<string>AppIcon</string>
	</dict>
	
	<!-- Requires Full Screen -->
	<key>UIRequiresFullScreen</key>
	<false/>
	
	<!-- Scene Configuration -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	
	<!-- iTunes File Sharing -->
	<key>UIFileSharingEnabled</key>
	<false/>
	
	<!-- App Uses Non-Exempt Encryption -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	
	<!-- Queries URL Schemes (for opening external links) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
	</array>
	
	<!-- Realtime (Pusher Channels) - optional -->
	<!-- Set these for realtime community discussion updates -->
	<key>BAYTREMOR_PUSHER_KEY</key>
	<string>14ac60cdb33bd2fff044</string>
	<key>BAYTREMOR_PUSHER_CLUSTER</key>
	<string>us3</string>
</dict>
</plist>
