            "mimeType": "application/manifest+json",
            "text": "{\n  \"name\": \"Bay Tremor - Live Bay Area Earthquake Tracking\",\n  \"short_name\": \"Bay Tremor\",\n  \"description\": \"Real-time earthquake tracking and seismic monitoring for the San Francisco Bay Area. Live USGS data, swarm detection, and regional analysis.\",\n  \"start_url\": \"/\",\n  \"scope\": \"/\",\n  \"id\": \"/\",\n  \"display\": \"standalone\",\n  \"background_color\": \"#0a0a0a\",\n  \"theme_color\": \"#0a0a0a\",\n  \"orientation\": \"portrait-primary\",\n  \"icons\": [\n    {\n      \"src\": \"/android-chrome-192x192.png\",\n      \"sizes\": \"192x192\",\n      \"type\": \"image/png\",\n      \"purpose\": \"any maskable\"\n    },\n    {\n      \"src\": \"/android-chrome-512x512.png\",\n      \"sizes\": \"512x512\",\n      \"type\": \"image/png\",\n      \"purpose\": \"any maskable\"\n    }\n  ],\n  \"categories\": [\"weather\", \"utilities\", \"news\"],\n  \"screenshots\": [],\n  \"shortcuts\": [\n    {\n      \"name\": \"View Dashboard\",\n      \"short_name\": \"Dashboard\",\n      \"description\": \"View live earthquake data\",\n      \"url\": \"/\",\n      \"icons\": [{ \"src\": \"/android-chrome-192x192.png\", \"sizes\": \"192x192\" }]\n    },\n    {\n      \"name\": \"San Ramon Earthquakes\",\n      \"short_name\": \"San Ramon\",\n      \"description\": \"View San Ramon area earthquakes\",\n      \"url\": \"/region/san-ramon\",\n      \"icons\": [{ \"src\": \"/android-chrome-192x192.png\", \"sizes\": \"192x192\" }]\n    }\n  ],\n  \"prefer_related_applications\": false\n}\n"
