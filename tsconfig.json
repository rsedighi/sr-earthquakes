{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "next/link":       ["src/lib/shims/next-link.tsx"],
      "next/image":      ["src/lib/shims/next-image.tsx"],
      "next/dynamic":    ["src/lib/shims/next-dynamic.tsx"],
      "next/navigation": ["src/lib/shims/next-navigation.ts"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node"]
  },
  "include": ["src", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "dist", "app", "components", "hooks", "lib"]
}
