{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node"]
  },
  "include": ["src", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "dist", "app", "components", "hooks", "lib"]
}
