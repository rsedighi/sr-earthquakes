# Copy this file to `.env` and fill in real values.
# Astro exposes variables prefixed with PUBLIC_ to the client bundle.
# NOTE: these are inlined at BUILD time — you must rebuild after changes.

# ── Datadog RUM ────────────────────────────────────────────────────────────
# Get these from Datadog → UX Monitoring → RUM Applications → your app.
# These are NOT the same as your Datadog API key or APP key.
PUBLIC_DD_APPLICATION_ID=00000000-0000-0000-0000-000000000000
PUBLIC_DD_CLIENT_TOKEN=pubXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PUBLIC_DD_SITE=datadoghq.com
PUBLIC_DD_ENV=prod
PUBLIC_DD_VERSION=2.0.0

# ── Google Analytics (optional) ────────────────────────────────────────────
# PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Base URL used for canonical/OG tags ────────────────────────────────────
# PUBLIC_BASE_URL=https://baytremor.com

# ── Address autocomplete (optional, server-side) ───────────────────────────
# If set, /api/geocode uses Mapbox first for the best full-address suggestions
# (house-number interpolation + strong partial matching). When unset, it falls
# back to the free Photon → Nominatim providers. Do NOT prefix with PUBLIC_ —
# this key must stay server-side. Mapbox free tier is ~100k requests/month;
# edge caching in /api/geocode helps keep usage low.
# MAPBOX_ACCESS_TOKEN=pk.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
