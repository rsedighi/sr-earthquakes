# Copy this file to `.env` and fill in real values.
# Astro exposes variables prefixed with PUBLIC_ to the client bundle.
# NOTE: these are inlined at BUILD time — you must rebuild after changes.

# ── Datadog RUM ────────────────────────────────────────────────────────────
# Get these from Datadog → UX Monitoring → RUM Applications → your app.
# These are NOT the same as your Datadog API key or APP key.
PUBLIC_DD_APPLICATION_ID=00000000-0000-0000-0000-000000000000
PUBLIC_DD_CLIENT_TOKEN=pubXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PUBLIC_DD_SITE=datadoghq.com
PUBLIC_DD_ENV=prod
PUBLIC_DD_VERSION=2.0.0

# ── Google Analytics (optional) ────────────────────────────────────────────
# PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Base URL used for canonical/OG tags ────────────────────────────────────
# PUBLIC_BASE_URL=https://baytremor.com
